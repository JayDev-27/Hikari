{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panels",
  "description": "Panel windows (Studio, Chat, Settings, Memories, Voice Lab, Activity, Confirm, Onboarding): events to the stage, file picker, hide on close",
  "windows": [
    "studio",
    "chat",
    "settings",
    "memory",
    "voicelab",
    "activity",
    "confirm",
    "onboarding"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "log:default"
  ]
}
