{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hikari",
  "version": "0.1.0",
  "identifier": "com.hikari.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "stage",
        "title": "Hikari",
        "url": "index.html#/stage",
        "width": 420,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "studio",
        "title": "Hikari — Character Studio",
        "url": "index.html#/studio",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": true
      },
      {
        "label": "chat",
        "title": "Chat with Hikari",
        "url": "index.html#/chat",
        "width": 420,
        "height": 640,
        "minWidth": 340,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "Hikari Settings",
        "url": "index.html#/settings",
        "width": 760,
        "height": 560,
        "minWidth": 640,
        "minHeight": 460,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true
      },
      {
        "label": "memory",
        "title": "Hikari — Memories",
        "url": "index.html#/memory",
        "width": 900,
        "height": 620,
        "minWidth": 700,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true
      },
      {
        "label": "voicelab",
        "title": "Hikari — Voice Lab",
        "url": "index.html#/voicelab",
        "width": 900,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true
      },
      {
        "label": "activity",
        "title": "Hikari — Activity",
        "url": "index.html#/activity",
        "width": 760,
        "height": 580,
        "minWidth": 600,
        "minHeight": 440,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true
      },
      {
        "label": "confirm",
        "title": "Hikari wants to act",
        "url": "index.html#/confirm",
        "width": 440,
        "height": 260,
        "minWidth": 440,
        "minHeight": 260,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "minimizable": false,
        "maximizable": false
      },
      {
        "label": "onboarding",
        "title": "Welcome to Hikari",
        "url": "index.html#/onboarding",
        "width": 760,
        "height": 560,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "center": true,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' hikari-pack: http://hikari-pack.localhost asset: http://asset.localhost blob: data:; connect-src 'self' hikari-pack: http://hikari-pack.localhost ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:* asset: http://asset.localhost blob: data:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; media-src 'self' blob: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/characters/**",
          "$RESOURCE/characters/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Entertainment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    }
  }
}
